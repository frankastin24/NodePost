<%- get_template_part('/np-content/admin/header',viewContext) %>

<section class="flex">

    <%- get_template_part('/np-content/admin/components/sidebar',viewContext) %>
    <script>
        const adminURL = "<%= adminURL %>";
        
    </script>
        <div class="dash-main">
            <header class="list-posts-header flex">
            <h1>All <%= data.topMenu %></h1>
            <a class="btn btn-primary" href="/np-admin/create-post/<%= cpt.slug %>">Create <%= cpt.singular %></a>
            </header>
            
            <table class="list-posts-table" width="100%">
                <tr>
                    <th style="width:60%;">Title</th>
                    
                    <th style="width:20%;">Author</th>
                    <th style="width:20%;">Date</th>
                    
                </tr>
               
                <% for (post of data.posts) { %>

                    <tr data-id="<%= post.id %>">
                        <td class="title"><a href="/np-admin/edit/<%= post.id %>"><%= post.title %></a></td>
                        <td></td>
                        <td><p><%= post.post_status %></p><p><%= post.updatedAt %></p></td>

                    </tr>
                <% } %>
            </table>

            <div class="pagination">
                <ul class="pages flex">
                    
                    <li><a href="/<%= adminURL %>/cpt/view-all">1</a></li>
                    
                    <% for(let i = 2; i < data.numPages; i ++) { %>
                        <li><a href="/<%= adminURL %>/cpt/view-all/<%= i %>"><%= i %></a></li>
                    <% } %>    
                
                </ul>
            </div>

        </div>

</section>

<%- get_template_part('/np-content/admin/footer',viewContext) %>