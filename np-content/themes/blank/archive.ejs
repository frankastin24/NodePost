<%- await getHeader('portfolio',viewContext) %>

   
        <div id="portfolio-hero">


            <div class="slides">


                <div style="background-image:url()" class="slide">

                </div>


            </div>

            <div class="overlay">
                <div class="container realtive">
                    <h3>PORTFOLIO</h3>
                </div>
            </div>
        </div>




        <div id="portfolio" class="container flex">

            <div class="portfolio-container">

                <% for (post of posts) { %>
                    <a class="portfolio-entry" href="/work/<%= post.slug %>" style="background-image:url()">
                        <div class="overlay">

                            <h2>
                                <%= post.title %>
                            </h2>

                            <div class="skills flex">
                                <span></span>
                            </div>
                        </div>
                    </a>
                    <% } %>


            </div>
        </div>

          <%- await getFooter() %>